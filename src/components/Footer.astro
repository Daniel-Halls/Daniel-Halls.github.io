---
import profile from "../../content/profile.json";

const labels: Record<string, string> = {
  googlescholar: "Google Scholar",
  pubmed: "PubMed",
  orcid: "ORCID",
  researchgate: "ResearchGate",
  github: "GitHub",
  linkedin: "LinkedIn",
};

const links = Object.entries(profile.social)
  .filter(([, url]) => Boolean(url))
  .map(([key, url]) => ({ label: labels[key] ?? key, url: url as string }));
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <p class="footer-name">{profile.name}</p>
      <p class="footer-meta">{profile.title}, {profile.employer}</p>
      <p class="footer-meta">
        <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </div>
    <ul class="footer-links">
      {links.map((l) => (
        <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
      ))}
    </ul>
    <p class="copyright">&copy; {new Date().getFullYear()} {profile.name}</p>
  </div>
</footer>
