---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import profile from "../../content/profile.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.bio } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.title}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/images/profile.png" />
  </head>
  <body>
    <Header />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
